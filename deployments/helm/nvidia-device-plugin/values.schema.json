{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "affinity": {
      "type": "object",
      "properties": {
        "nodeAffinity": {
          "type": "object",
          "properties": {
            "requiredDuringSchedulingIgnoredDuringExecution": {
              "type": "object",
              "properties": {
                "nodeSelectorTerms": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "matchExpressions": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "key": {
                              "type": "string"
                            },
                            "operator": {
                              "type": "string"
                            },
                            "values": {
                              "type": "array",
                              "items": {
                                "type": "string"
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "allowDefaultNamespace": {
      "type": "boolean"
    },
    "cdi": {
      "type": "object",
      "properties": {
        "featureFlags": {
          "type": [
            "string",
            "null"
          ]
        },
        "nvidiaHookPath": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "compatWithCPUManager": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "componentSelectorLabels": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "config": {
      "type": "object",
      "properties": {
        "default": {
          "type": "string"
        },
        "fallbackStrategies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "map": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "name": {
          "type": "string"
        }
      }
    },
    "configManager": {
      "type": "object",
      "properties": {
        "resources": {
          "type": "object"
        }
      }
    },
    "deviceDiscoveryStrategy": {
      "type": [
        "string",
        "null"
      ]
    },
    "deviceIDStrategy": {
      "type": [
        "string",
        "null"
      ]
    },
    "deviceListStrategy": {
      "type": [
        "string",
        "null"
      ]
    },
    "devicePlugin": {
      "type": "object",
      "properties": {
        "enableHostNetwork": {
          "type": "boolean"
        },
        "enabled": {
          "type": "boolean"
        },
        "resources": {
          "type": "object"
        }
      }
    },
    "failOnInitError": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "fullnameOverride": {
      "type": "string"
    },
    "gdrcopyEnabled": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "gdsEnabled": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "gfd": {
      "type": "object",
      "properties": {
        "enableHostNetwork": {
          "type": "boolean"
        },
        "enabled": {
          "type": "boolean"
        },
        "nameOverride": {
          "type": "string"
        },
        "namespaceOverride": {
          "type": "string"
        },
        "noTimestamp": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "resources": {
          "type": "object"
        },
        "securityContext": {
          "type": "object",
          "properties": {
            "privileged": {
              "type": "boolean"
            }
          }
        },
        "sleepInterval": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(infinite|[-+]?(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h))+))$"
        }
      }
    },
    "image": {
      "type": "object",
      "properties": {
        "pullPolicy": {
          "type": "string"
        },
        "repository": {
          "type": "string"
        },
        "tag": {
          "type": [
            "string",
            "integer"
          ]
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          }
        }
      }
    },
    "migStrategy": {
      "type": [
        "string",
        "null"
      ]
    },
    "mofedEnabled": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "mps": {
      "type": "object",
      "properties": {
        "enableHostNetwork": {
          "type": "boolean"
        },
        "enableHostPID": {
          "type": "boolean"
        },
        "resources": {
          "type": "object"
        },
        "root": {
          "type": "string"
        }
      }
    },
    "nameOverride": {
      "type": "string"
    },
    "namespaceOverride": {
      "type": "string"
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "nvidiaDevRoot": {
      "type": [
        "string",
        "null"
      ]
    },
    "nvidiaDriverCapabilities": {
      "type": [
        "string",
        "null"
      ]
    },
    "nvidiaDriverRoot": {
      "type": [
        "string",
        "null"
      ]
    },
    "podAnnotations": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "podSecurityContext": {
      "type": "object"
    },
    "priorityClassName": {
      "type": "string"
    },
    "resources": {
      "type": "object"
    },
    "runtimeClassName": {
      "type": [
        "string",
        "null"
      ]
    },
    "securityContext": {
      "type": "object"
    },
    "selectorLabelsOverride": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "tolerations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "effect": {
            "type": "string"
          },
          "key": {
            "type": "string"
          },
          "operator": {
            "type": "string"
          }
        }
      }
    },
    "updateStrategy": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        }
      }
    }
  }
}
